{
  "name": "prtf-edit",
  "displayName": "Printer File DDS edit",
  "description": "Extension that helps you create and modify your printer file DDS on IBM i",
  "icon": "assets/prtf_extension_icon.png",
  "author": {
    "name": "Christian Larsen",
    "url": "https://www.linkedin.com/in/christianlarsenvalverde/"
  },
  "publisher": "ChristianLarsen",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/christianlarsen/prtf-edit"
  },
  "bugs": {
    "url": "https://github.com/christianlarsen/prtf-edit/issues"
  },
  "homepage": "https://github.com/christianlarsen/prtf-edit#readme",
  "keywords": [
    "rpg",
    "ibmi",
    "rpgle",
    "sqlrpgle",
    "as400",
    "dds",
    "printer",
    "prtf"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "license": "MIT",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "preview": true,
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prtf-edit",
          "title": "PRTF Structure",
          "icon": "assets/prtf_extension_icon_activity.svg",
          "when": "true"
        }
      ]
    },
    "views": {
      "prtf-edit": [
        {
          "id": "prtf-edit.schema-view",
          "name": "Definition",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "prtf-edit.preview-record",
        "title": "Preview Page Layout",
        "icon": "$(open-preview)"
      },
      {
        "command": "prtf-edit.edit-constant-text",
        "title": "Edit Text..."
      },
      {
        "command": "prtf-edit.fill-constant",
        "title": "Fill to Width of..."
      },
      {
        "command": "prtf-edit.edit-attributes",
        "title": "Edit Attributes..."
      },
      {
        "command": "prtf-edit.edit-indicators",
        "title": "Indicators..."
      },
      {
        "command": "prtf-edit.edit-record-attributes",
        "title": "Edit Attributes..."
      },
      {
        "command": "prtf-edit.edit-file-spacing",
        "title": "Edit Spacing..."
      },
      {
        "command": "prtf-edit.edit-record-spacing",
        "title": "Edit Spacing..."
      },
      {
        "command": "prtf-edit.add-record",
        "title": "New Record...",
        "icon": "$(add)"
      },
      {
        "command": "prtf-edit.rename-record",
        "title": "Rename Record..."
      },
      {
        "command": "prtf-edit.copy-record",
        "title": "Copy Record..."
      },
      {
        "command": "prtf-edit.delete-record",
        "title": "Delete Record"
      },
      {
        "command": "prtf-edit.rename-field",
        "title": "Rename Field..."
      },
      {
        "command": "prtf-edit.copy-element",
        "title": "Copy Field/Constant..."
      },
      {
        "command": "prtf-edit.delete-element",
        "title": "Delete Field/Constant"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "prtf-edit.preview-record",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "inline@1"
        },
        {
          "command": "prtf-edit.add-record",
          "when": "view == prtf-edit.schema-view && viewItem == treeGroup:records",
          "group": "inline@1"
        },
        {
          "command": "prtf-edit.edit-constant-text",
          "when": "view == prtf-edit.schema-view && viewItem == constant",
          "group": "1_modification@1"
        },
        {
          "command": "prtf-edit.fill-constant",
          "when": "view == prtf-edit.schema-view && viewItem == constant",
          "group": "1_modification@2"
        },
        {
          "command": "prtf-edit.edit-attributes",
          "when": "view == prtf-edit.schema-view && (viewItem == field || viewItem == constant)",
          "group": "1_modification@3"
        },
        {
          "command": "prtf-edit.edit-indicators",
          "when": "view == prtf-edit.schema-view && (viewItem == field || viewItem == constant || viewItem == attribute)",
          "group": "1_modification@4"
        },
        {
          "command": "prtf-edit.edit-record-attributes",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "1_modification@1"
        },
        {
          "command": "prtf-edit.edit-file-spacing",
          "when": "view == prtf-edit.schema-view && viewItem == file",
          "group": "1_modification@1"
        },
        {
          "command": "prtf-edit.edit-record-spacing",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "1_modification@2"
        },
        {
          "command": "prtf-edit.add-record",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "2_recordActions@1"
        },
        {
          "command": "prtf-edit.rename-record",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "2_recordActions@2"
        },
        {
          "command": "prtf-edit.copy-record",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "2_recordActions@3"
        },
        {
          "command": "prtf-edit.delete-record",
          "when": "view == prtf-edit.schema-view && viewItem == record",
          "group": "9_recordActions"
        },
        {
          "command": "prtf-edit.rename-field",
          "when": "view == prtf-edit.schema-view && viewItem == field",
          "group": "2_itemActions@1"
        },
        {
          "command": "prtf-edit.copy-element",
          "when": "view == prtf-edit.schema-view && (viewItem == field || viewItem == constant)",
          "group": "2_itemActions@2"
        },
        {
          "command": "prtf-edit.delete-element",
          "when": "view == prtf-edit.schema-view && (viewItem == field || viewItem == constant)",
          "group": "9_itemActions"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "mocha": "^11.7.2",
    "typescript": "^5.8.3"
  }
}
